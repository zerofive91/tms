{"v":1,"voice":"tc_65681f1157abc7266fd4f350","lines":{"对你来说，最宝贵的是什么？":{"f":"e8c6800a6d.mp3","d":259,"t":[20,34,46,66,76,104,123,145,161,175,187,203,253]},"点一点卡片，把幸福装满吧。":{"f":"d1a9fa2188.mp3","d":295,"t":[24,38,54,75,99,121,147,165,187,204,222,244,288]},"就算拥有一切，心里还是空空的。为什么呢？":{"f":"82aa694cc5.mp3","d":389,"t":[18,34,52,66,78,102,116,150,170,193,213,227,243,263,271,309,323,335,345,383]},"神起初造人，是为了与我们亲密相交。":{"f":"1a7fe013f7.mp3","d":379,"t":[22,54,74,92,112,128,168,181,193,205,221,233,255,277,295,317,373]},"但是因为我们犯了罪，罪进来了，我们和神的关系就断了。":{"f":"419388c86a.mp3","d":489,"t":[16,30,44,56,68,80,94,112,124,140,178,202,219,238,244,283,293,307,325,343,355,379,401,419,443,483]},"如今，人与神之间有了一道深深的鸿沟。":{"f":"9f4d5dd7c0.mp3","d":379,"t":[16,34,50,80,100,118,138,152,193,207,213,229,253,275,291,303,327,373]},"神这样告诉我们自己的光景。":{"f":"5cb2efaacc.mp3","d":259,"t":[24,46,58,76,92,106,119,143,159,171,181,203,253]},"依次点一点这三张卡片。":{"f":"4f733cf948.mp3","d":235,"t":[18,38,61,75,93,115,123,145,161,182,228]},"这就是与神隔绝的人的光景。":{"f":"5da82a9f85.mp3","d":274,"t":[18,36,56,79,97,119,139,155,165,179,189,212,268]},"靠自己的力量能到神那里吗？":{"f":"a5f26ab9f1.mp3","d":280,"t":[20,42,58,72,82,100,137,153,173,193,209,225,273]},"把卡片拖到悬崖之间，也可以直接点一下。":{"f":"a0b6e60135.mp3","d":358,"t":[16,32,50,76,90,108,128,148,163,181,207,221,233,245,261,277,291,309,353]},"再试试别的卡片吧。":{"f":"af2323eccf.mp3","d":183,"t":[14,32,49,69,87,101,119,142,178]},"人的力量无法跨越这道鸿沟。":{"f":"396ca19081.mp3","d":280,"t":[20,36,46,62,92,110,131,157,177,189,205,229,273]},"那么，难道就没有办法了吗？":{"f":"d45d536819.mp3","d":259,"t":[22,34,38,84,98,117,133,147,163,183,199,209,253]},"这里有神为你预备的解决办法。":{"f":"abc09c0122.mp3","d":298,"t":[16,30,56,76,98,112,128,145,163,195,215,231,251,293]},"耶稣基督成了通往神的桥。":{"f":"35fe2ad6c4.mp3","d":298,"t":[22,36,54,72,106,128,153,175,197,217,229,293]},"一个一个点一点耶稣所做的事。":{"f":"ab775223fd.mp3","d":295,"t":[0,34,42,65,81,103,131,153,173,193,212,226,244,288]},"如今，通往神的路已经打开了。":{"f":"dbeadd0148.mp3","d":314,"t":[22,40,58,97,115,135,155,167,195,209,230,248,272,308]},"桥已经架好，神也给了应许。":{"f":"6431ba298e.mp3","d":295,"t":[24,50,65,83,109,129,151,173,189,204,215,240,288]},"依次点“听”和“信”，走过这座桥吧。":{"f":"45ee8e53a3.mp3","d":329,"t":[20,38,72,96,96,118,118,138,138,157,157,197,219,235,249,263,287,323]},"神向相信的人这样应许。":{"f":"5e637eaa6d.mp3","d":280,"t":[28,50,74,94,110,122,161,175,193,217,273]},"那么，怎样才算是相信呢？":{"f":"9ef760e401.mp3","d":259,"t":[24,38,42,78,98,117,135,153,169,193,213,253]},"你听到敲门声了吗？拉一下门把手，把门打开吧。":{"f":"7429d16f82.mp3","d":470,"t":[24,38,58,78,104,124,142,152,158,213,221,245,265,283,307,323,357,373,389,409,427,463]},"现在你就可以敞开心门，接待耶稣基督进来。":{"f":"c871022f73.mp3","d":389,"t":[22,44,62,72,88,100,112,134,154,175,191,223,237,255,273,287,303,319,339,383]},"我们一起用心来祷告好吗？":{"f":"1ba2400a10.mp3","d":248,"t":[24,36,46,64,90,111,129,145,163,181,197,243]},"你现在在哪一边？":{"f":"196a598395.mp3","d":175,"t":[20,34,55,73,89,99,125,168]},"要在哪里度过永恒，需要你自己决定。":{"f":"70eceb1c77.mp3","d":368,"t":[16,32,48,70,98,114,132,152,175,209,223,239,257,277,295,315,363]},"桥已经架好了，只要迈出一步就可以。":{"f":"d5f1bbb5ab.mp3","d":358,"t":[14,42,56,74,98,120,128,171,183,199,215,225,251,275,293,315,353]},"你已经接待耶稣进入你心里了吗？那么，他现在在哪里呢？":{"f":"e8d2bdf7b0.mp3","d":520,"t":[20,36,48,70,88,106,124,152,170,186,208,226,240,253,261,307,325,331,371,387,405,423,439,457,473,513]},"长按屏幕试试。":{"f":"e3e51fa6ec.mp3","d":175,"t":[24,47,61,81,101,124,168]},"向上滑动，走过这座桥吧。":{"f":"7788ce5f32.mp3","d":274,"t":[24,46,69,89,103,133,155,171,185,200,224,268]},"现在，花一点时间，把心里的话直接告诉神吧。":{"f":"e1cacd7360.mp3","d":444,"t":[20,38,54,102,113,131,155,169,187,205,223,239,251,263,301,320,340,358,370,392,438]},"你的祷告已经传到神那里了":{"f":"dbd6309380.mp3","d":253,"t":[20,32,42,63,87,99,115,137,157,177,196,210]},"并不难，只要相信就可以。":{"f":"2cbc7f008a.mp3","d":243,"t":[14,32,46,67,93,105,123,145,165,184,200,238]},"恭喜你！现在你已经成为神的儿女了。":{"f":"e7cdb25802.mp3","d":345,"t":[20,38,56,62,103,123,139,153,165,181,201,231,252,276,284,300,338]},"你回到神身边，神比谁都更欢喜。":{"f":"d1eba77e8c.mp3","d":350,"t":[16,30,46,64,86,104,122,161,181,203,231,249,269,295,343]},"1. 你是罪人":{"f":"af645ab35b.mp3","d":138,"t":[16,16,16,16,34,50,75]},"因为世人都犯了罪，亏缺了 神的荣耀。":{"f":"9305c3cf44.mp3","d":711,"t":[22,36,62,80,104,124,140,156,172,235,259,281,291,319,343,359,379,397]},"2. 你将要受审判":{"f":"b242a2f22e.mp3","d":159,"t":[10,10,10,10,22,40,58,77,99]},"按着定命，人人都有一死，死后且有审判。":{"f":"b4fc037e75.mp3","d":755,"t":[42,56,70,90,106,130,150,175,191,203,235,247,297,319,341,359,377,401,425]},"3. 刑罚就是死亡，也就是地狱":{"f":"fa678cc2e0.mp3","d":298,"t":[22,22,22,22,48,78,96,116,135,153,183,195,209,225,245]},"惟有胆怯的、不信的、可憎的、杀人的、淫乱的、行邪术的、拜偶像的，和一切说谎话的，他们的分就在烧着硫磺的火湖里；这是第二次的死。":{"f":"57bc34f41f.mp3","d":1737,"t":[30,44,64,92,118,124,156,180,208,216,244,274,302,308,360,384,410,418,456,480,510,518,570,597,623,647,655,687,713,731,759,767,809,819,845,871,891,915,941,949,979,995,1007,1021,1045,1097,1115,1141,1157,1179,1197,1211,1235,1257,1265,1313,1329,1347,1355,1383,1399,1417,1429]},"多做善事，就能到神那里吗？":{"f":"0378c3fef0.mp3","d":269,"t":[18,36,52,76,86,116,131,145,165,187,203,217,263]},"善事固然可贵，却填不满罪的鸿沟。":{"f":"188da1edff.mp3","d":363,"t":[24,50,74,89,111,133,149,177,199,223,237,259,276,288,312,358]},"热心过宗教生活，就能到神那里吗？":{"f":"5134401a9d.mp3","d":350,"t":[20,42,62,80,100,120,142,152,189,203,219,241,265,281,295,343]},"宗教生活也填不满罪的鸿沟。":{"f":"1f0d662d94.mp3","d":298,"t":[14,34,56,78,118,135,159,175,197,215,227,249,293]},"努力正直地生活，就能到神那里吗？":{"f":"98e8bb01cc.mp3","d":329,"t":[20,36,54,76,88,98,120,130,169,185,199,219,239,255,269,323]},"离得最近，但还是到不了。":{"f":"da7884f4bd.mp3","d":235,"t":[12,28,42,63,81,105,125,147,163,180,190,228]},"多学习、多思考，就能到神那里吗？":{"f":"c04ef837bf.mp3","d":368,"t":[22,42,68,78,110,134,152,177,207,221,237,261,285,301,317,363]},"人的智慧无法认识神。":{"f":"132b6bb15e.mp3","d":230,"t":[18,32,46,66,98,115,135,155,169,223]},"神啊，我承认我是个罪人。我相信并感谢耶稣爱我，替我担当了罪，被钉死在十字架上，又复活了。现在我相信耶稣是我的救主，接待他进入我的心。求你进入我的心，引导我的人生。奉耶稣的名祷告，阿们。":{"f":"189944eb0c.mp3","d":2111,"t":[38,66,66,116,130,152,170,186,200,214,238,256,296,314,338,390,412,436,458,476,500,520,528,560,578,594,615,631,645,661,709,727,751,765,777,803,817,845,863,897,923,949,969,977,1029,1053,1101,1119,1141,1167,1189,1215,1231,1241,1255,1277,1285,1351,1367,1383,1415,1439,1457,1471,1487,1507,1551,1573,1597,1621,1641,1655,1671,1689,1713,1735,1757,1769,1781,1807,1825,1871,1893,1911,1925,1937,1960,1986,2006,2045,2058,2104]},"人就是赚得全世界，赔上自己的生命，有什么益处呢？":{"f":"5bffa78896.mp3","d":810,"t":[36,60,80,94,114,128,158,176,190,224,242,265,279,293,309,329,347,373,389,403,415,437,459,467]},"所有的义都像污秽的衣服。":{"f":"1d83d87788.mp3","d":543,"t":[26,44,58,74,122,140,162,184,202,216,236,246]},"你们得救是本乎恩，也因着信；这并不是出于自己，乃是 神所赐的；也不是出于行为，免得有人自夸。":{"f":"be54e83a26.mp3","d":1437,"t":[20,34,48,70,104,122,148,176,188,226,244,262,282,304,346,362,384,398,414,434,452,476,487,603,629,641,665,685,713,739,749,807,825,839,857,877,897,925,943,977,995,1009,1025,1047,1071,1085]},"人心比万物都诡诈，坏到极处。":{"f":"3fece0d769.mp3","d":677,"t":[24,48,74,94,118,139,163,187,197,249,269,287,313,325]},"世人凭自己的智慧，既不认识 神。":{"f":"f4384f5f3d.mp3","d":666,"t":[16,34,56,84,102,114,128,152,168,198,216,232,260,273,313,337]},"有一条路，人以为正，至终成为死亡之路。":{"f":"278a150d84.mp3","d":622,"t":[16,30,44,70,78,108,126,142,162,182,220,238,260,278,300,318,342,358,368]},"惟有基督在我们还作罪人的时候为我们死， 神的爱就在此向我们显明了。":{"f":"4760b6ea89.mp3","d":959,"t":[38,56,74,94,120,136,146,162,182,202,224,240,252,272,305,321,335,359,371,373,445,467,487,513,531,553,577,597,605,623,645,669,677]},"我当日所领受又传给你们的：第一，就是基督照圣经所说，为我们的罪死了，而且埋葬了；又照圣经所说，第三天复活了。":{"f":"f3f7b59b44.mp3","d":1737,"t":[46,64,86,104,122,148,176,192,218,236,248,264,270,356,366,408,422,442,458,476,496,518,538,562,585,595,663,681,693,705,719,751,773,781,815,831,857,879,905,913,985,1003,1025,1045,1069,1091,1101,1141,1149,1187,1219,1243,1271,1279]},"我就是道路、真理、生命；若不藉着我，没有人能到父那里去。":{"f":"9e57824084.mp3","d":839,"t":[20,40,56,70,96,104,150,172,180,198,220,238,275,291,303,321,339,347,389,403,421,437,453,477,495,513,531,543]},"我实实在在地告诉你们，那听我话、又信差我来者的，就有永生；不至于定罪，是已经出死入生了。":{"f":"175fcb9c46.mp3","d":1215,"t":[16,34,50,66,86,102,114,136,152,164,178,240,254,278,296,306,332,348,370,396,412,432,452,460,497,515,531,557,577,617,635,651,667,693,709,737,753,769,795,823,843,865,887,895]},"凡接待他的，就是信他名的人，他就赐他们权柄作 神的儿女。":{"f":"fba1797a76.mp3","d":964,"t":[30,56,76,94,116,124,158,174,192,214,236,258,274,292,344,360,378,399,417,439,468,499,513,557,581,609,617,627]},"看哪，我站在门外叩门，若有听见我声音就开门的，我要进到他那里去，我与他，他与我一同坐席。":{"f":"fd1cf39536.mp3","d":1343,"t":[24,46,54,100,116,136,156,176,198,222,240,308,322,340,362,380,400,416,434,452,476,500,506,560,574,592,612,630,652,668,689,703,769,785,803,815,843,869,891,903,967,995,1021,1033]},"信子的人有永生；不信子的人得不着永生， 神的震怒常在他身上。":{"f":"12de537b13.mp3","d":1016,"t":[32,56,72,86,106,124,152,172,224,246,270,286,298,336,352,364,384,411,431,433,491,513,525,549,575,607,625,643,667,685]},"还是你藐视他丰富的恩慈、宽容、忍耐，不晓得他的恩慈是领你悔改呢？你竟任着你刚硬不悔改的心，为自己积蓄忿怒，以致 神震怒，显他公义审判的日子来到。":{"f":"f74aa013bf.mp3","d":1949,"t":[18,36,52,136,158,172,190,212,226,242,262,276,314,340,354,363,387,405,459,475,497,511,525,541,561,595,609,625,643,667,689,697,785,801,821,839,853,869,889,907,925,945,963,979,995,1027,1045,1061,1083,1105,1129,1153,1162,1230,1248,1260,1298,1324,1346,1356,1402,1426,1448,1466,1488,1510,1534,1546,1564,1580,1600,1618]},"耶和华－你的 神是施行拯救、大有能力的主。他在你中间必因你欢欣喜乐，默然爱你，且因你喜乐而欢呼。":{"f":"31f3a68d78.mp3","d":1520,"t":[34,52,70,82,98,124,136,188,216,248,270,294,318,338,388,408,430,452,466,480,490,568,584,602,616,638,674,690,710,734,758,786,810,820,864,886,914,936,944,1006,1027,1043,1069,1093,1121,1137,1161,1171]},"这见证就是 神赐给我们永生；这永生也是在他儿子里面。人有了 神的儿子就有生命，没有 神的儿子就没有生命。我将这些话写给你们信奉 神儿子之名的人，要叫你们知道自己有永生。":{"f":"87f0400ebb.mp3","d":2254,"t":[24,46,66,86,112,124,178,206,226,244,258,272,300,318,366,382,408,444,460,474,490,527,539,555,575,595,651,675,697,707,737,757,789,799,825,841,863,883,901,959,981,999,1041,1059,1087,1097,1123,1141,1157,1179,1197,1217,1257,1269,1287,1299,1319,1359,1377,1391,1401,1419,1447,1465,1477,1513,1521,1539,1553,1571,1585,1603,1650,1664,1680,1692,1706,1724,1762,1782,1798,1814,1838,1858]}}}