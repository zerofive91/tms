 không vâng phục Ngài chẳng được sự sống ấy mà còn mang án phạt của Đức Chúa Trời.":{"f":"276e44a47c.mp3","d":1115,"t":[37,48,49,56,64,77,79,137,143,158,159,165,168,174,175,180,183,186,190,192,198,201,207,220,221,230,238,244,245,250,254,259,261,263,270,278,279,291,299,308,311,312,318,322,330,333,334,342,349,358,358,360,404,412,422,423,437,446,447,452,455,458,462,465,466,471,474,481,484,486,490,493,496,502,504,514,517,521,532,533,541,544,550,556,559,560,565,567,570,573,575,579,587,588,599,605,612,615,617,627,636,637,655,660,661,669,674,682,683,689,694,701,704,706,712,720,722,728,731,735,744,746,752,756,759,761,765,768,772,774,780,783,787,792,793,799,802,808,824,824]},"Hay anh chị em coi thường lòng nhân từ, khoan dung, nhẫn nại vô biên của Đức Chúa Trời đối với anh chị em? Điều đó không có ý nghĩa nào với anh chị em sao? Hay không nhận thấy Ngài nhân từ vì chờ đợi anh chị em hối cải? Ngoan cố, không hối cải là tự dồn chứa hình phạt khủng khiếp cho mình trong ngày đoán phạt của Đức Chúa Trời, khi Ngài dùng công lý xét xử loài người.":{"f":"3a97a5ae17.mp3","d":2275,"t":[42,46,51,52,59,65,68,69,73,76,80,81,92,101,102,112,118,123,124,128,131,136,140,144,146,148,152,157,165,167,169,173,175,179,187,188,199,205,205,207,241,243,246,250,259,260,267,275,284,286,286,288,296,299,302,309,310,319,326,337,339,350,357,358,370,377,382,387,388,394,397,400,401,405,408,411,412,416,418,421,425,426,431,434,439,446,447,451,456,462,463,467,471,473,475,480,485,488,489,493,496,499,501,511,522,522,523,598,600,604,608,609,613,617,618,628,630,633,635,638,639,643,646,647,655,656,662,666,668,673,676,677,684,690,699,701,706,709,711,713,718,720,723,724,728,731,736,737,745,754,756,766,774,786,786,787,849,852,856,858,862,864,867,872,875,876,880,882,885,889,890,898,901,905,910,911,918,920,926,934,935,940,943,947,953,954,965,973,974,1024,1030,1032,1041,1043,1049,1050,1060,1066,1071,1072,1079,1081,1086,1088,1092,1094,1098,1100,1106,1114,1115,1124,1131,1137,1139,1145,1153,1166,1166,1168,1245,1247,1250,125